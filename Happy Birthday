// Happy Birthday 

// Pins definieren
const int buzzerPin = 2;
const int ledLow = 4;    // Für tiefe Töne
const int ledMid = 5;    // Für mittlere Töne
const int ledHigh = 6;   // Für hohe Töne

// Globale Variablen für das Timing (Gemütlicher Walzer-Takt, 140 BPM)
int tempo = 140;
int wholenote = (60000 * 4) / tempo;
int divider = 0;
int noteDuration = 0;

// Definition aller benötigten Notenfrequenzen
#define NOTE_C4  262
#define NOTE_D4  294
#define NOTE_E4  330
#define NOTE_F4  349
#define NOTE_G4  392
#define NOTE_A4  440
#define NOTE_AS4 466
#define NOTE_C5  523
#define REST      0

// Melodie: "Happy Birthday to you"
// Note gefolgt von der Dauer (4 = Viertelnote, 8 = Achtelnote, 2 = Halbe Note, etc.)
// Punktierte Noten sind mit einem Minuszeichen versehen (z.B. -4)
int melody[] = {
  NOTE_C4,8, NOTE_C4,8, 
  NOTE_D4,4, NOTE_C4,4, NOTE_F4,4,
  NOTE_E4,2, NOTE_C4,8, NOTE_C4,8,
  NOTE_D4,4, NOTE_C4,4, NOTE_G4,4,
  NOTE_F4,2, NOTE_C4,8, NOTE_C4,8,

  NOTE_C5,4, NOTE_A4,4, NOTE_F4,4,
  NOTE_E4,4, NOTE_D4,4, NOTE_AS4,8, NOTE_AS4,8,
  NOTE_A4,4, NOTE_F4,4, NOTE_G4,4,
  NOTE_F4,2
};

int notes = sizeof(melody) / sizeof(melody[0]);

void setup() {
  pinMode(buzzerPin, OUTPUT);
  pinMode(ledLow, OUTPUT);
  pinMode(ledMid, OUTPUT);
  pinMode(ledHigh, OUTPUT);
}

void loop() {
  for (int thisNote = 0; thisNote < notes; thisNote = thisNote + 2) {
    int currentNote = melody[thisNote];
    divider = melody[thisNote + 1];
    
    if (divider > 0) {
      noteDuration = (wholenote) / divider;
    } else if (divider < 0) {
      noteDuration = (wholenote) / abs(divider);
      noteDuration *= 1.5; 
    }

    // LED-Frequenzweichen für die Geburtstagshymne
    if (currentNote == REST) {
      digitalWrite(ledLow, LOW);
      digitalWrite(ledMid, LOW);
      digitalWrite(ledHigh, LOW);
    } 
    else if (currentNote < 300) { 
      // Tiefe Töne (C4, D4)
      digitalWrite(ledLow, HIGH);
      digitalWrite(ledMid, LOW);
      digitalWrite(ledHigh, LOW);
    } 
    else if (currentNote >= 300 && currentNote < 400) { 
      // Mittlere Töne (E4, F4, G4)
      digitalWrite(ledLow, LOW);
      digitalWrite(ledMid, HIGH);
      digitalWrite(ledHigh, LOW);
    } 
    else { 
      // Hohe Töne (A4, AS4, C5)
      digitalWrite(ledLow, LOW);
      digitalWrite(ledMid, LOW);
      digitalWrite(ledHigh, HIGH);
    }

    // Ton abspielen
    if (currentNote != REST) {
      tone(buzzerPin, currentNote, noteDuration * 0.9);
    }

    delay(noteDuration);
    noTone(buzzerPin);
  }

  // LEDs aus am Ende des Liedes
  digitalWrite(ledLow, LOW);
  digitalWrite(ledMid, LOW);
  digitalWrite(ledHigh, LOW);

  // 5 Sekunden Pause vor der nächsten Gratulationsrunde
  delay(5000);
}
