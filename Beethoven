// Beethoven mit Intro-Blinken

// Pins definieren
const int buzzerPin = 2;
const int ledLow = 4;    // Für tiefe Töne
const int ledMid = 5;    // Für mittlere Töne
const int ledHigh = 6;   // Für hohe Töne

// Globale Variablen für das Timing
int tempo = 130;
int wholenote = (60000 * 4) / tempo;
int divider = 0;
int noteDuration = 0;

// Definition aller Notenfrequenzen
#define NOTE_C3  131
#define NOTE_CS3 139
#define NOTE_D3  147
#define NOTE_DS3 156
#define NOTE_E3  165
#define NOTE_F3  175
#define NOTE_FS3 185
#define NOTE_G3  196
#define NOTE_GS3 208
#define NOTE_A3  220
#define NOTE_AS3 233
#define NOTE_B3  247
#define NOTE_C4  262
#define NOTE_CS4 277
#define NOTE_D4  294
#define NOTE_DS4 311
#define NOTE_E4  330
#define NOTE_F4  349
#define NOTE_FS4 370
#define NOTE_G4  392
#define NOTE_G4S 415
#define NOTE_A4  440
#define NOTE_AS4 466
#define NOTE_B4  494
#define NOTE_C5  523
#define NOTE_CS5 541
#define NOTE_D5  587
#define NOTE_DS5 622
#define NOTE_E5  659
#define REST      0

// Melodie: "Für Elise" (Hauptthema)
int melody[] = {
  // Haupt-Riff (Das berühmte Intro)
  NOTE_E5,8, NOTE_DS5,8,
  NOTE_E5,8, NOTE_DS5,8, NOTE_E5,8, NOTE_B4,8, NOTE_D5,8, NOTE_C5,8,
  NOTE_A4,4, REST,8, NOTE_C3,8, NOTE_E3,8, NOTE_A3,8,
  NOTE_B3,4, REST,8, NOTE_E3,8, NOTE_G4S,8, NOTE_B3,8,
  NOTE_C4,4, REST,8, NOTE_E3,8, NOTE_E5,8, NOTE_DS5,8,

  // Wiederholung des Riffs
  NOTE_E5,8, NOTE_DS5,8, NOTE_E5,8, NOTE_B4,8, NOTE_D5,8, NOTE_C5,8,
  NOTE_A4,4, REST,8, NOTE_C3,8, NOTE_E3,8, NOTE_A3,8,
  NOTE_B3,4, REST,8, NOTE_E3,8, NOTE_C4,8, NOTE_B3,8,
  NOTE_A4,4, REST,8, NOTE_B4,8, NOTE_C5,8, NOTE_D5,8,

  // Zweiter Teil
  NOTE_E5,4, REST,8, NOTE_G4,8, NOTE_F4,8, NOTE_E4,8,
  NOTE_D4,4, REST,8, NOTE_F4,8, NOTE_E4,8, NOTE_D4,8,
  NOTE_E4,4, REST,8, NOTE_E3,8, NOTE_D4,8, NOTE_C4,8,
  NOTE_B3,4, REST,8, NOTE_E4,8, NOTE_E5,8, REST,8, 
  NOTE_E5,8, NOTE_E5,4, NOTE_DS5,8, NOTE_E5,8, REST,8, 
  NOTE_DS5,8, NOTE_E5,8, NOTE_DS5,8, NOTE_E5,8, NOTE_B4,8, NOTE_D5,8, NOTE_C5,8,

  // Finale Überleitung zurück zum Hauptthema
  NOTE_A4,4, REST,8, NOTE_C3,8, NOTE_E3,8, NOTE_A3,8,
  NOTE_B3,4, REST,8, NOTE_E3,8, NOTE_G4S,8, NOTE_B3,8,
  NOTE_C4,4, REST,8, NOTE_E4,8, NOTE_E5,8, NOTE_DS5,8,
  
  NOTE_E5,8, NOTE_DS5,8, NOTE_E5,8, NOTE_B4,8, NOTE_D5,8, NOTE_C5,8,
  NOTE_A4,4, REST,8, NOTE_C3,8, NOTE_E3,8, NOTE_A3,8,
  NOTE_B3,4, REST,8, NOTE_E3,8, NOTE_C4,8, NOTE_B3,8,
  NOTE_A4,2
};

int notes = sizeof(melody) / sizeof(melody[0]);

void setup() {
  pinMode(buzzerPin, OUTPUT);
  pinMode(ledLow, OUTPUT);
  pinMode(ledMid, OUTPUT);
  pinMode(ledHigh, OUTPUT);
}

void loop() {
  // === INTRO: 4 Mal Piepen und alle 3 LEDs synchron aufleuchten lassen ===
  for (int i = 0; i < 4; i++) {
    // Töne an (NOTE_A4 mit 440Hz klingt hier super als Signalton)
    tone(buzzerPin, NOTE_A4);
    digitalWrite(ledLow, HIGH);
    digitalWrite(ledMid, HIGH);
    digitalWrite(ledHigh, HIGH);
    delay(250); // 

    // Töne aus
    noTone(buzzerPin);
    digitalWrite(ledLow, LOW);
    digitalWrite(ledMid, LOW);
    digitalWrite(ledHigh, LOW);
    delay(250); //
  }



  // === HAUPTMELODIE: Das eigentliche Abspielen von "Für Elise" ===
  for (int thisNote = 0; thisNote < notes; thisNote = thisNote + 2) {
    int currentNote = melody[thisNote];
    divider = melody[thisNote + 1];
    
    if (divider > 0) {
      noteDuration = (wholenote) / divider;
    } else if (divider < 0) {
      noteDuration = (wholenote) / abs(divider);
      noteDuration *= 1.5; 
    }

    // LED-Frequenzweichen
    if (currentNote == REST) {
      digitalWrite(ledLow, LOW);
      digitalWrite(ledMid, LOW);
      digitalWrite(ledHigh, LOW);
    } 
    else if (currentNote < 250) { 
      digitalWrite(ledLow, HIGH);
      digitalWrite(ledMid, LOW);
      digitalWrite(ledHigh, LOW);
    } 
    else if (currentNote >= 250 && currentNote < 450) { 
      digitalWrite(ledLow, LOW);
      digitalWrite(ledMid, HIGH);
      digitalWrite(ledHigh, LOW);
    } 
    else { 
      digitalWrite(ledLow, LOW);
      digitalWrite(ledMid, LOW);
      digitalWrite(ledHigh, HIGH);
    }

    // Ton abspielen
    if (currentNote != REST) {
      tone(buzzerPin, currentNote, noteDuration * 0.95);
    }

    delay(noteDuration);
    noTone(buzzerPin);
  }

  // LEDs aus am Ende des Liedes
  digitalWrite(ledLow, LOW);
  digitalWrite(ledMid, LOW);
  digitalWrite(ledHigh, LOW);

  // 7 Sekunden Pause, bis die loop() wieder von vorne mit dem Intro startet
  delay(7000);
}
